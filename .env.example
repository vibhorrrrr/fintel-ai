# Fintel AI Environment Variables
# Copy this file to .env.local and fill in the values

# Yahoo Finance API (no key required for public quotes)
# YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# Redis (Phase 2 - replace in-memory cache)
# REDIS_URL=

# OpenAI API (Phase 2 - LLM-powered chat)
# OPENAI_API_KEY=

# Razorpay (Phase 1 - Pro tier payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
